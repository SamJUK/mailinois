#!/bin/sh
# Installed by `make hooks`. Conventional Commits: type(scope)!: summary
head -n1 "$1" | grep -Eq '^(Merge |Revert |fixup! |squash! )|^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9/_.-]+\))?!?: .+' && exit 0
echo "Commit message must follow Conventional Commits, such as: fix(store): count expired mail once" >&2
exit 1
